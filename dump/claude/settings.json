{
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Bash(bash ~/.claude/scripts/pr-state.sh:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__github__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/post-push-ci.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/pr-body-snapshot.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/stop-ci-check.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/tmux-session-id.sh"
          }
        ]
      }
    ]
  }
}
