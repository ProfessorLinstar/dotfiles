[Unit]
Description=Pin the Framework 16's Radeon 780M at the high performance level so HDMI audio doesn't stutter
# Installed to /etc/systemd/system by the hdmi_audio_fix feature of ~/dotfiles/install.sh. SteamOS keeps
# /etc/systemd/system across updates (/usr/lib/rauc/atomic-update-keep.conf), so it needs no keep list.
#
# With the default auto level, HDMI audio from the 780M (PCI ID 1002:15bf, found by ID rather than by address or
# card number, which can change) is choppy at idle even though PipeWire reports no underruns. A 720 MHz socclk floor
# at the manual level made it better but not reliably; only the high level fixes it.
# amdgpu creates power_dpm_force_performance_level before it can take writes and refuses them ("Permission denied")
# until then, which failed the unit at boot, so the write is retried for up to 30 s.
# It runs again after every resume, in case the driver resets the level. Steam's "Manual GPU clock" toggle writes
# the level too, so turning it off sets it back to auto until the next boot or resume.
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'for dev in /sys/bus/pci/devices/*; do \
  [ "$$(cat "$$dev/vendor"):$$(cat "$$dev/device")" = 0x1002:0x15bf ] || continue; \
  tries=0; \
  until echo high 2>/dev/null > "$$dev/power_dpm_force_performance_level"; do \
    tries=$$((tries + 1)); \
    [ "$$tries" -lt 30 ] || { echo "$$dev refused the high level for 30 s" >&2; exit 1; }; \
    sleep 1; \
  done; \
done'

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
